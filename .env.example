# Local preview uses SQLite through DATABASE_URL="file:./dev.db".
# Railway production must use the PostgreSQL URL supplied by Railway.
NODE_ENV=production
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="8h"
TEACHER_PASSCODE="replace-with-a-private-teacher-passcode"
CLIENT_ORIGIN="https://your-service.up.railway.app"
ENABLE_OPEN_CORS=false
# Railway Volume mount path for uploaded PDFs and images in production.
UPLOAD_DIR="/data/uploads"

# Before production deployment, replace prisma/schema.prisma with
# prisma/schema.postgresql.prisma, then run: npx prisma generate && npx prisma db push

# SofizPay automatic verification
SOFIZPAY_BASE_URL="https://sofizpay.com"
SOFIZPAY_ACCOUNT="replace-with-sofizpay-account"
# Encrypted merchant secret used only server-side for Operation Details.
SOFIZPAY_ENCRYPTED_SECRET_KEY="replace-with-encrypted-secret-key"
APP_BASE_URL="https://your-public-domain.example"
SOFIZPAY_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"

# Email provider (leave empty until SMTP credentials are available)
EMAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# SMS provider (leave empty until a provider contract and credentials are available)
SMS_PROVIDER=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
# Optional OAuth-style provider credentials, if the selected provider requires them.
SMS_CLIENT_ID=""
SMS_CLIENT_SECRET=""
SMS_TOKEN_URL=""

# Telegram Bot (leave empty to keep Telegram linking and notifications dormant)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Facebook Messenger / Meta (leave empty until the Page and app are configured)
META_APP_ID="1281264560693047"
META_PAGE_ID="102191728284856"
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v26.0"
META_MESSENGER_PAGE_NAME="أستاذ الفيزياء و الرياضيات"
# Use the Page's m.me handle here; do not use a phone number.
META_PAGE_MME_NAME=""
# Keep parent Messenger enforcement hidden until the linking flow is validated.
ENFORCE_PARENT_MESSENGER_LINK="false"
